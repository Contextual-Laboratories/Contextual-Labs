{
  // Docs under docs/ are a synced mirror authored upstream, not here — rules
  // that would fight generated/aggregated content are relaxed rather than
  // fixed at the source (this repo can't edit that content anyway).
  "config": {
    "default": true,
    "MD013": false, // line length — synced docs contain long generated lines
    "MD033": false, // inline HTML — some docs content embeds raw HTML
    "MD041": false // first line must be a top-level heading — not true for every synced page
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules/**"]
}
